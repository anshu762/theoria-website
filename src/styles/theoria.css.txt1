/* :root{
  --navy:#060C29; --navy-2:#0D1740; --navy-3:#16245C;
  --blue:#9DBEFF; --purple:#B68AF6;
  --blue-d:#5B7CF0; --purple-d:#7C4DDB;
  --ivory:#F6F8FF; --tint:#EEF2FF; --ink:#101B38; --muted:#5D6785; --line:#E1E6F3;
  --grad:linear-gradient(120deg,var(--blue),var(--purple));
  --shadow:0 18px 50px -18px rgba(6,12,41,.28);
} */
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;font-family:'DM Sans';color:var(--ink);background:#fff;-webkit-font-smoothing:antialiased;overflow-x:hidden}
h1,h2,h3{font-family:'DM Sans';font-weight:500;color:var(--navy);margin:0}
h1{font-size:clamp(2.6rem,3.8vw,3.2rem);line-height:1.05;letter-spacing:-.03em}
h2{font-size:clamp(2rem,3.8vw,3.2rem);line-height:1.12;letter-spacing:-.025em;margin:12px 0 22px}
h3{font-size:1.5rem;line-height:1.25;margin:10px 0}
p{line-height:1.75;color:var(--muted);margin:0 0 14px}
a{color:inherit;text-decoration:none}
button,input,select,textarea{font:inherit}
button{cursor:pointer}
.shell{max-width:1240px;padding:0 16px}
.grad-text{background:var(--navy);-webkit-background-clip:text;background-clip:text;color:transparent}

.eyebrow{display:inline-flex;align-items:center;gap:10px;font-size:1rem;font-weight:700;letter-spacing:.2em;text-transform:uppercase;color:#4F5FA0}
.eyebrow:before{content:"";width:26px;height:3px;border-radius:3px;background:var(--grad)}
.dark .eyebrow{color:var(--blue)}

#progress{position:fixed;top:0;left:0;height:3px;width:0;background:var(--grad);z-index:60}

/* header */
header{position:sticky;top:0;z-index:50;background:rgba(255,255,255,.93);border-bottom:1px solid var(--line);backdrop-filter:blur(14px)}
.nav{height:88px;display:flex;align-items:center;justify-content:space-between;gap:24px}
.brand{display:flex;align-items:center;gap:12px}
.brand svg{flex-shrink:0}
.wordmark{font-family:'DM Sans';font-weight:700;font-size:28px;letter-spacing:.03em;color:var(--navy);line-height:1}
.wordmark small{display:block;font:700 7.5px Inter,sans-serif;letter-spacing:.2em;margin-top:6px}
.brand img{height:60px;width:auto;mix-blend-mode:multiply}
.navlinks{display:flex;gap:4px;align-items:center;font-size:15px;font-weight:600}
.navlinks a.lnk{position:relative;padding:10px 12px;color:var(--navy);transition:color .2s}
.navlinks a.lnk:after{content:"";position:absolute;left:12px;right:12px;bottom:4px;height:2px;border-radius:2px;background:var(--grad);transform:scaleX(0);transform-origin:left;transition:transform .3s}
.navlinks a.lnk:hover,.navlinks a.lnk.active{color:var(--purple-d)}
.navlinks a.lnk:hover:after,.navlinks a.lnk.active:after{transform:scaleX(1)}
.mobiletoggle{display:none;border:0;background:none;padding:8px;color:var(--navy)}

/* buttons */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;background:var(--grad);color:#fff;border:1px solid var(--navy);padding:15px 10px;border-radius:8px;font-size:16px;font-weight:700;letter-spacing:.03em;transition:transform .2s,box-shadow .2s,background .3s,color .3s}
.btn:hover{transform:translateY(-2px);box-shadow:0 14px 30px -10px rgba(6,12,41,.5)}
.btn.nav-cta{padding:12px 22px;margin-left:10px}
.btn.nav-cta:hover{background:var(--grad);color:var(--navy);border-color:transparent}
.btn.secondary{background:transparent;color:var(--navy);border-color:#9AA7C5}
.btn.secondary:hover{background:var(--navy);color:#fff;border-color:var(--navy)}
.btn.pastel{background:var(--grad);border-color:transparent;color:var(--page)}
.btn.pastel:hover{filter:brightness(1.06);box-shadow:0 14px 30px -10px rgba(182,138,246,.7)}
.btn .arr{transition:transform .25s}.btn:hover .arr{transform:translateX(4px)}
.actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:28px}

/* sections */
section{padding:25px 0 !important;position:relative}
.band{background:linear-gradient(100deg,#EAF1FF,#F5F0FF)}
.dark{background:var(--navy);color:#fff;overflow:hidden}
.dark h2,.dark h3{color:#fff}.dark p{color:#C5CEE6}
.dark:before{content:"";position:absolute;right:-180px;top:-180px;width:520px;height:520px;border-radius:50%;}
.dark:after{content:"";position:absolute;left:-200px;bottom:-220px;width:520px;height:520px;border-radius:50%;}
.dark > .shell{position:relative;z-index:1}
.intro{max-width:780px;font-size:17px}

/* hero */
.hero{background:var(--ivory);position:relative;overflow:hidden}
.hero:before{content:"";position:absolute;right:-200px;top:-220px;width:700px;height:700px;}
.hero:after{content:"";position:absolute;left:-160px;bottom:-260px;width:520px;height:520px;}
.hero-inner{min-height:680px;display:grid;grid-template-columns:1.15fr .95fr;align-items:center;gap:50px;position:relative;z-index:1;padding-top:10px;padding-bottom:10px}
.hero h1{margin:18px 0 24px}
.hero p{max-width:580px;font-size:17.5px}
.trust{display:flex;gap:26px;flex-wrap:wrap;margin-top:38px;font-size:11.5px;font-weight:700;color:#455476;letter-spacing:.05em}
.trust span:before{content:'✦';background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent;margin-right:8px}
.hero-art{height:480px;border-radius:200px 200px 22px 22px;background:linear-gradient(160deg,#060C29 5%,#16245C 55%,#9DBEFF 120%);display:flex;align-items:center;justify-content:center;position:relative;box-shadow:0 30px 70px -20px rgba(6,12,41,.5);overflow:hidden}
.hero-art .ring{position:absolute;border-radius:50%;border:1.5px solid rgba(157,190,255,.55);border-left-color:transparent;}
.ring.r1{width:300px;height:300px;animation:spin 22s linear infinite}
.ring.r2{width:390px;height:390px;opacity:.5;animation:spin 34s linear infinite reverse}
.bigicon{width:230px;height:auto;position:relative;z-index:2;animation:float 5s ease-in-out infinite;filter:drop-shadow(0 20px 30px rgba(0,0,0,.35))}
.spark{position:absolute;color:var(--purple);font-size:34px;animation:twinkle 3s ease-in-out infinite}
.spark.s1{top:22%;right:16%}.spark.s2{bottom:30%;left:14%;font-size:22px;color:var(--blue);animation-delay:1.2s}
.hero-art .caption{position:absolute;bottom:30px;color:#E4E9FF;font-size:11px;letter-spacing:.22em;text-transform:uppercase}
.chip{position:absolute;z-index:3;background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.25);backdrop-filter:blur(8px);color:#fff;font-size:11px;font-weight:600;letter-spacing:.08em;padding:8px 14px;border-radius:999px;animation:float 6s ease-in-out infinite}
.chip.c1{top:20%;left:6%}.chip.c2{top:46%;right:3%;animation-delay:1s}.chip.c3{bottom:20%;left:10%;animation-delay:2s}
@keyframes spin{to{transform:rotate(360deg)}}
@keyframes float{50%{transform:translateY(-10px)}}
@keyframes twinkle{50%{opacity:.35;transform:scale(.8) rotate(20deg)}}

/* page head */
.pagehead{background:var(--ivory);padding:50px 0 46px;position:relative;overflow:hidden}
.pagehead:before{content:"";position:absolute;right:-120px;top:-200px;width:560px;height:560px;background:radial-gradient(circle,rgba(182,138,246,.3),rgba(157,190,255,.2) 45%,transparent 70%)}
.pagehead .shell{position:relative}
.pagehead h1{font-size:clamp(2.5rem,5vw,4.5rem);margin:16px 0 22px;max-width:980px}
.pagehead .watermark{position:absolute;right:36px;bottom:-30px;width:210px;opacity:.14;pointer-events:none}

/* cards */
.three{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;margin-top:10px}
.split{display:grid;grid-template-columns:1fr 1fr;gap:70px;align-items:center}
.card{border:1px solid var(--line);border-radius:14px;padding:34px;background:#fff;transition:transform .3s,box-shadow .3s,border-color .3s;position:relative}
.card:hover{transform:translateY(-6px);box-shadow:var(--shadow);border-color:#cdd6f5}
.card p{font-size:14.5px}
.card .tag{font-size:10.5px;font-weight:800;letter-spacing:.16em;text-transform:uppercase;color:#5A66A3}
.card ul{padding:0;list-style:none;margin:5px 0 10px;font-size:13.5px;line-height:1.55}
.card li{position:relative;padding:6px 0 6px 24px}
.card li:before{content:"";position:absolute;left:0;top:12px;width:12px;height:12px;border-radius:50%;background:var(--grad)}
.card.featured{background:linear-gradient(160deg,#F3F4FF,#EEF3FF);border-color:#D6D8FA}
.card.featured:before{content:"Most chosen path";position:absolute;top:-12px;right:22px;background:var(--grad);color:var(--navy);font-size:10px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;padding:5px 12px;border-radius:999px; z-index:20}
.card.fellow{background:linear-gradient(160deg,var(--navy),var(--navy-3));color:#fff;border-color:var(--navy)}
.card.fellow h2,.card.fellow h3{color:#fff}
.card.fellow p,.card.fellow .tag{color:#C9D3EF}
.card.fellow li:before{background:var(--blue)}
.program-card{display:flex;flex-direction:column}
.program-card .btn{margin-top:auto}
.num-big{font-family:'DM Sans';font-size:44px;line-height:1;color:#B7C3F2;margin-bottom:6px}

.tiles{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:10px}
.tile{background:#fff;border:1px solid var(--line);padding:26px;border-radius:12px;transition:transform .3s,box-shadow .3s}
.band .tile{background:rgba(255,255,255,.78)}
.tile:hover{transform:translateY(-5px);box-shadow:var(--shadow)}
.tile .dot{width:38px;height:38px;border-radius:10px;background:var(--grad);display:grid;place-items:center;margin-bottom:14px;color:var(--navy);font-size:15px}
.tile strong{display:block;margin-bottom:8px;font-size:16px;color:var(--navy)}
.tile p{font-size:13.5px;margin:0}

.quote{font-family:'DM Sans';font-size:28px;line-height:1.45;color:var(--navy);padding:44px 44px 44px 56px;background:linear-gradient(135deg,#EEF2FF,#F6F0FF);border-radius:0 16px 16px 0;position:relative;border-left:4px solid var(--purple)}
.quote:before{content:"“";position:absolute;left:16px;top:6px;font-size:80px;line-height:1;color:var(--purple);opacity:.55}

.step{display:flex;gap:22px;border-bottom:1px solid rgba(255,255,255,.14);padding:24px 0}
.step:last-of-type{border-bottom:0}
.step b{font-family:'DM Sans';font-size:34px;font-weight:500;background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent;min-width:52px}
.step strong{display:block;font-size:17px;margin-bottom:2px}
.step p{margin:4px 0 0;font-size:13.5px}
.mutedbox{background:#F5F7FC;border-radius:16px;padding:30px;border:1px solid var(--line)}
.mutedbox strong{color:var(--navy)}
.mutedbox .step{border-color:var(--line)}
.mutedbox .step p{color:var(--muted)}

.research-grid{display:grid;grid-template-columns:1fr 1fr;gap:22px;margin-top:10px}
.research-card{padding:34px;background:#fff;border:1px solid var(--line);border-radius:14px;transition:transform .3s,box-shadow .3s;position:relative;overflow:hidden}
.research-card:before{content:"";position:absolute;left:0;top:0;bottom:0;width:4px;background:var(--grad)}
.research-card:hover{transform:translateY(-5px);box-shadow:var(--shadow)}
.research-card .category{display:inline-flex;align-items:center;gap:8px;font-size:11px;letter-spacing:.13em;text-transform:uppercase;color:#5A66A3;font-weight:600}
.research-card .category i{font-style:normal;background:var(--grad);color:var(--navy);font-size:9.5px;font-weight:800;padding:3px 9px;border-radius:999px;letter-spacing:.08em}
.research-card h3{font-size:23px}
.research-card p{font-size:14.5px;margin:0}
.research-card .ico{width:44px;height:44px;border-radius:12px;background:var(--tint);display:grid;place-items:center;margin-bottom:14px;color:var(--purple-d)}

.note{font-size:12px;color:#6E7791;border-left:3px solid var(--purple);background:rgba(182,138,246,.08);padding:10px 14px;border-radius:0 8px 8px 0;margin-top:20px;max-width:900px;line-height:1.6}
.note:before{content:"REVIEW NOTE · ";font-weight:800;letter-spacing:.1em;color:var(--purple-d);font-size:10px}

.tablewrap{overflow:auto;border:1px solid var(--line);border-radius:14px;background:#fff;box-shadow:0 10px 30px -18px rgba(6,12,41,.25)}
table{width:100%;border-collapse:collapse;min-width:760px}
th,td{text-align:left;padding:19px 22px;border-bottom:1px solid var(--line);font-size:13.5px;vertical-align:top;color:var(--muted)}
th{background:var(--navy);color:#fff;font-size:12px;letter-spacing:.1em;text-transform:uppercase;font-weight:700}
td:first-child{font-weight:700;color:var(--navy)}
tbody tr{transition:background .2s}tbody tr:hover{background:#F4F6FF}
tr:last-child td{border-bottom:0}
.hl{background:linear-gradient(180deg,rgba(182,138,246,.08),transparent)}

.faq details{border:1px solid var(--line);border-radius:12px;margin-bottom:12px;background:#fff;transition:box-shadow .3s,border-color .3s}
.faq details[open]{box-shadow:var(--shadow);border-color:#cdd6f5}
.faq summary{font-weight:700;cursor:pointer;padding:22px 26px;list-style:none;display:flex;justify-content:space-between;gap:16px;align-items:center;color:var(--navy)}
.faq summary::-webkit-details-marker{display:none}
.faq summary:after{content:"+";width:30px;height:30px;border-radius:50%;background:var(--tint);display:grid;place-items:center;font-size:20px;color:var(--purple-d);transition:transform .3s,background .3s;flex-shrink:0}
.faq details[open] summary:after{transform:rotate(45deg);background:var(--grad);color:var(--navy)}
.faq details p{padding:0 26px 22px;margin:0;font-size:14.5px}
.source{display:inline-block;margin-top:6px;font-size:12.5px;font-weight:600;color:var(--purple-d);border-bottom:1px solid currentColor}

.imageblock{border-radius:20px;min-height:360px;background:linear-gradient(140deg,#C7DBFF,#E9DFFF);display:flex;flex-direction:column;gap:22px;justify-content:center;align-items:center;color:var(--navy);position:relative;overflow:hidden;box-shadow:var(--shadow)}
.imageblock:before{content:"";position:absolute;width:320px;height:320px;border-radius:50%;background:rgba(255,255,255,.35);right:-90px;top:-90px}
.pc-title{font-family:'DM Sans';font-size:clamp(2.2rem,5vw,4rem);font-weight:600;line-height:1;position:relative;color:var(--navy)}
.pc-title small{font:700 12px 'DM Sans';letter-spacing:.28em;margin-left:10px}
.play{width:68px;height:68px;border-radius:50%;background:var(--navy);display:grid;place-items:center;color:#fff;box-shadow:0 14px 30px -8px rgba(6,12,41,.55);position:relative;transition:transform .25s}
.imageblock:hover .play{transform:scale(1.1)}
.wave{display:flex;gap:5px;align-items:center;height:36px;position:relative}
.wave i{width:4px;border-radius:4px;background:var(--navy);opacity:.7;animation:eq 1.2s ease-in-out infinite}
.wave i:nth-child(1){height:30%}.wave i:nth-child(2){height:70%;animation-delay:.1s}.wave i:nth-child(3){height:100%;animation-delay:.2s}.wave i:nth-child(4){height:55%;animation-delay:.3s}.wave i:nth-child(5){height:85%;animation-delay:.4s}.wave i:nth-child(6){height:40%;animation-delay:.5s}.wave i:nth-child(7){height:75%;animation-delay:.6s}.wave i:nth-child(8){height:50%;animation-delay:.7s}.wave i:nth-child(9){height:90%;animation-delay:.8s}
@keyframes eq{50%{transform:scaleY(.4)}}

.formgrid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:20px}
input,select,textarea{width:100%;padding:15px 16px;border:1px solid #CDD5E4;border-radius:10px;background:#fff;color:var(--ink);transition:border-color .2s,box-shadow .2s}
input:focus,select:focus,textarea:focus{outline:none;border-color:var(--purple);box-shadow:0 0 0 4px rgba(182,138,246,.2)}
textarea{grid-column:1/-1;min-height:120px;resize:vertical}
.formgrid .btn{grid-column:1/-1;justify-self:start}

.footer{background:#050B24;color:#EAF0FF;padding:70px 0 30px;position:relative;overflow:hidden}
.footer:before{content:"";position:absolute;right:-120px;top:-160px;width:460px;height:460px;border-radius:50%;background:radial-gradient(circle,rgba(182,138,246,.22),transparent 65%)}
.footer .shell{position:relative}
.footer .wordmark{color:#fff}
.footer .tagline{font-family:'DM Sans';font-size:20px;color:#CBD7F5;margin:20px 0 0}
.footerlinks{display:flex;gap:26px;flex-wrap:wrap;font-size:13px;margin:30px 0}
.footerlinks a{color:#DCE5FF;position:relative;padding-bottom:3px}
.footerlinks a:after{content:"";position:absolute;left:0;bottom:0;height:2px;width:0;background:var(--grad);transition:width .3s}
.footerlinks a:hover:after{width:100%}
.footer hr{border:0;border-top:1px solid #263250;margin:0 0 20px}
.footer .copy{font-size:12px;color:#8E9BBB;margin:0}

.toast{position:fixed;right:20px;bottom:84px;z-index:80;max-width:340px;background:var(--navy);color:#fff;padding:16px 20px;border-radius:12px;font-size:13.5px;box-shadow:var(--shadow);border-left:4px solid var(--purple);transform:translateY(30px);opacity:0;pointer-events:none;transition:all .4s}
.toast.show{transform:none;opacity:1}

.page{animation:pageIn .5s ease both}
@keyframes pageIn{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
.rv{opacity:0;transform:translateY(26px);transition:opacity .8s ease,transform .8s ease;transition-delay:var(--d,0ms)}
.rv.in{opacity:1;transform:none}

@media(max-width:1020px){
  .navlinks{display:none;position:absolute;top:88px;left:0;right:0;background:#fff;padding:18px 28px 26px;flex-direction:column;align-items:flex-start;gap:0;border-bottom:1px solid var(--line);box-shadow:0 20px 30px -20px rgba(6,12,41,.3)}
  .navlinks.show{display:flex;animation:pageIn .3s ease}
  .navlinks a.lnk{width:100%;padding:14px 0;border-bottom:1px solid var(--line)}
  .navlinks a.lnk:after{display:none}
  .btn.nav-cta{margin:16px 0 0}
  .mobiletoggle{display:block}
  .hero-inner,.split{grid-template-columns:1fr;gap:40px}
  .hero-art{height:400px;max-width:440px;width:100%;margin:auto}
  .three,.tiles{grid-template-columns:1fr 1fr}
  .pagehead .watermark{display:none}
}
@media(max-width:640px){
  .shell{padding:0 20px}
  section{padding:66px 0}
  .three,.tiles,.research-grid,.formgrid{grid-template-columns:1fr}
  .nav{height:76px}.navlinks{top:76px}
  .wordmark{font-size:24px}.brand svg{width:50px;height:40px}
  .hero-inner{padding-top:40px;min-height:0}
  .hero-art{height:340px}.bigicon{width:170px}.ring.r1{width:230px;height:230px}.ring.r2{width:300px;height:300px}
  .card,.research-card{padding:26px}
  .quote{font-size:22px;padding:34px 26px 34px 40px}
  .trust{gap:12px}
   .toast{left:16px;right:16px;max-width:none;bottom:90px}
}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}.rv{opacity:1;transform:none}}

/* ============ Hero right side: Our Mentor Network ============ */
.mentor-net{position:relative;isolation:isolate;overflow:hidden;border-radius:28px;padding:34px 28px 22px;background:linear-gradient(160deg,#060C29 5%,#16245C 58%,#2B3F8E 130%);box-shadow:0 30px 70px -20px rgba(6,12,41,.5)}
.mentor-net:before{content:"";position:absolute;left:0;right:0;top:0;height:3px;background:var(--grad);z-index:2}

.mn-ring{position:absolute;z-index:0;border-radius:50%;border:1.5px solid rgba(157,190,255,.45);border-left-color:transparent;border-bottom-color:rgba(182,138,246,.75);pointer-events:none}
.mn-r1{width:300px;height:300px;right:-120px;top:-130px;animation:spin 26s linear infinite}
.mn-r2{width:420px;height:420px;right:-180px;top:-190px;opacity:.5;animation:spin 38s linear infinite reverse}
.mn-spark{position:absolute;z-index:0;right:26px;top:96px;font-size:20px;color:var(--purple);animation:twinkle 3s ease-in-out infinite;pointer-events:none}

.mn-body{position:relative;z-index:1}
.mn-head{display:flex;align-items:center;gap:14px;margin-bottom:14px}
.mn-icon{flex-shrink:0;animation:float 5s ease-in-out infinite;filter:drop-shadow(0 10px 14px rgba(0,0,0,.35))}
.hero .mentor-net h2{color:#fff;font-size:clamp(1.6rem,2.3vw,2.05rem);line-height:1.15;letter-spacing:-.02em;margin:0}
.hero .mentor-net p{max-width:none;font-size:14.5px;line-height:1.7;color:#C9D3EF;margin:0 0 22px}

.mn-grid{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:1fr 1fr;gap:10px}
.mn-tile{position:relative;display:flex;align-items:center;gap:10px;min-height:58px;padding:9px 12px;border-radius:12px;background:rgba(255,255,255,.96);color:var(--navy);transition:transform .25s,box-shadow .25s}
.mn-tile:hover{transform:translateY(-3px);box-shadow:0 14px 26px -12px rgba(0,0,0,.6)}
.mn-tile:after{content:"";position:absolute;inset:0;border-radius:inherit;pointer-events:none;opacity:0;box-shadow:0 0 0 2px rgba(182,138,246,.95),0 0 22px rgba(157,190,255,.6);animation:mnGlow 12s linear infinite;animation-delay:calc(var(--i) * 1.2s)}
.rv.in .mn-tile{animation:mnIn .6s cubic-bezier(.2,.7,.2,1) backwards;animation-delay:calc(var(--i) * 70ms + 350ms)}
.mn-logo{width:36px;height:36px;flex-shrink:0;display:grid;place-items:center}
.mn-logo img{max-width:100%;max-height:100%;object-fit:contain;display:block}
.mn-mono{width:36px;height:36px;border-radius:50%;display:grid;place-items:center;background:var(--grad);color:var(--navy);font-family:'DM Sans';font-weight:700;font-size:12px;letter-spacing:.02em}
.mn-name{font-size:11.5px;font-weight:700;line-height:1.3;color:var(--navy)}
.mn-disclaimer{display:block;margin-top:16px;font-size:10px;line-height:1.5;color:#8E9BBB}

@keyframes mnIn{from{opacity:0;transform:translateY(14px) scale(.96)}}
@keyframes mnGlow{0%{opacity:0}3%,9%{opacity:1}13%,100%{opacity:0}}

@media(max-width:1020px){
  .mentor-net{max-width:560px;width:100%;margin:auto}
}
@media(max-width:640px){
  .mentor-net{padding:28px 20px 20px;border-radius:24px}
}
@media(max-width:480px){
  .mn-tile{flex-direction:column;justify-content:center;text-align:center;gap:6px;padding:12px 8px}
  .mn-name{font-size:11px}
}

/* ============ Pathway card prices ============ */
.price{align-items:baseline;flex-wrap:wrap;gap:6px 12px;margin:6px 0 16px;padding:14px 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.price-amt{font-family:'DM Sans';font-size:2.4rem;font-weight:600;line-height:1;letter-spacing:-.02em;color:var(--navy)}
.price-note{font-size:10.5px;font-weight:800;letter-spacing:.16em;text-transform:uppercase;color:#5A66A3}

.card.featured .price{border-color:#D6D8FA}
.card.featured .price-amt{background:linear-gradient(100deg,var(--blue-d),var(--purple-d));-webkit-background-clip:text;background-clip:text;}

.card.fellow .price{border-color:rgba(255,255,255,.16)}
.card.fellow .price-amt{color:#fff}
.card.fellow .price-note{color:#C9D3EF}

@media(max-width:640px){
  .price-amt{font-size:2.1rem}
}

/* =====================================================================
   POLISH LAYER – fluid type, spacing, depth, all devices
   (append at END of file; delete this block to revert)
   ===================================================================== */
:root{
  --hdr:76px;
  --ban:60px;
  --view:calc(100vh - var(--hdr) - var(--ban));
  --gutter:clamp(18px,4vw,32px);
  --sec:clamp(56px,7.5vw,92px);
  --ease:cubic-bezier(.2,.7,.2,1);
}
@supports(height:100svh){:root{--view:calc(100svh - var(--hdr) - var(--ban))}}
@media(max-width:640px){:root{--hdr:64px}}

/* ---------- base ---------- */
html{scroll-padding-top:calc(var(--hdr) + 12px);-webkit-text-size-adjust:100%}
body{font-size:15px;line-height:1.5}
img,video{max-width:100%}
::selection{background:rgba(182,138,246,.28)}
a:focus-visible,button:focus-visible{outline:2px solid var(--purple-d);outline-offset:3px}

/* ---------- type scale ---------- */
h1{font-size:clamp(2.1rem,1.2rem + 2.6vw,3.4rem);line-height:1.08;letter-spacing:-.03em}
h2{font-size:clamp(1.65rem,1.1rem + 1.8vw,2.5rem);line-height:1.15;margin:10px 0 16px}
h3{font-size:1.25rem;line-height:1.25;margin:8px 0}
h1,h2,h3{text-wrap:balance;overflow-wrap:break-word}
p{line-height:1.7;margin:0 0 12px}
.eyebrow{font-size:.74rem;letter-spacing:.18em;gap:10px}
.eyebrow:before{width:24px;height:3px}
.intro{font-size:16px}

/* ---------- layout rhythm ---------- */
.shell{padding:0 var(--gutter)}
section{padding:var(--sec) 0}
.split{gap:clamp(28px,5vw,64px)}
.actions{gap:12px;margin-top:24px}
@media(min-width:1500px){.shell{max-width:1320px}}

/* ---------- header ---------- */
.nav{height:var(--hdr);gap:20px}
.wordmark{font-size:clamp(22px,2vw,26px)}
.brand img{height:clamp(42px,4vw,52px)}

/* ---------- buttons ---------- */
.btn{padding:13px 10px;font-size:15px;border-radius:10px}
.btn:active{transform:translateY(0)}
.btn.nav-cta{padding:11px 20px}

/* ---------- hero ---------- */
.hero{
  background:
    radial-gradient(rgba(91,124,240,.13) 1px,transparent 1.6px) 0 0/22px 22px,
    var(--ivory);
}
.hero:before{animation:drift 18s ease-in-out infinite alternate}
.hero:after{animation:drift 22s ease-in-out infinite alternate-reverse}
@keyframes drift{to{transform:translate(-40px,30px) scale(1.08)}}

.hero-inner{
  min-height:clamp(520px,var(--view),740px);
  grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);
  gap:clamp(28px,4vw,56px);
  padding-top:clamp(28px,5vh,56px);
  padding-bottom:clamp(28px,5vh,56px);
}
.hero h1{margin:14px 0 18px}
.hero p{max-width:540px;font-size:clamp(15.5px,.5vw + 13.5px,17.5px)}

.trust{gap:10px;margin-top:26px;font-size:11.5px}
.trust span{
  display:inline-flex;align-items:center;padding:8px 14px;border-radius:999px;
  background:rgba(255,255,255,.78);border:1px solid var(--line);
  backdrop-filter:blur(6px);box-shadow:0 8px 20px -14px rgba(6,12,41,.4)
}
.trust span:before{margin-right:8px}

/* mentor card */
.mentor-net{
  padding:clamp(22px,3vw,32px) clamp(18px,2.6vw,28px) 20px;
  border-radius:24px;
}
.mn-tile{min-height:54px}
.mn-name{font-size:12px}

/* ---------- page head (inner pages) ---------- */
.pagehead{padding:clamp(48px,7vw,50px) 0 clamp(44px,6.5vw,72px)}
.pagehead h1{font-size:clamp(2rem,1rem + 3.6vw,3.8rem);margin:14px 0 18px}

/* ---------- cards ---------- */
.three{gap:clamp(16px,2vw,24px);margin-top:24px}
.card{padding:clamp(20px,2.4vw,20px);border-radius:16px;overflow:visible}
.card h3{font-size:1.35rem;margin:6px 0 4px}
.card p{font-size:14px;line-height:1.65}
.card ul{margin:10px 0 22px;font-size:13.5px;line-height:1.5}
.card li{padding:5px 0 5px 26px}
.card li:before{
  content:"✓";top:9px;width:16px;height:16px;
  display:grid;place-items:center;font-size:9px;font-weight:800;color:var(--navy)
}
.card:after{
  content:"";position:absolute;left:18px;right:18px;top:0;height:3px;
  border-radius:0 0 3px 3px;background:var(--grad);
  transform:scaleX(0);transform-origin:left;transition:transform .45s var(--ease)
}
.card:hover:after{transform:scaleX(1)}
.card.featured{
  border-color:#CFD2F7;
  box-shadow:0 26px 50px -30px rgba(124,77,219,.5)
}
.card.fellow{box-shadow:0 26px 50px -30px rgba(6,12,41,.6)}

/* prices */
.price{margin:10px 0 14px;padding:12px 0}
.price-amt{font-size:clamp(1.9rem,1.4rem + 1vw,2.3rem)}

/* ---------- tiles / steps / research / quote ---------- */
.tiles{gap:clamp(12px,1.6vw,16px)}
.tile{padding:clamp(18px,2vw,24px)}
.tile strong{font-size:15.5px}
.step{padding:18px 0;gap:18px}
.step b{font-size:30px;min-width:46px}
.mutedbox{padding:clamp(20px,2.4vw,28px)}
.research-grid{gap:clamp(16px,2vw,22px)}
.research-card{padding:clamp(22px,2.4vw,30px)}
.research-card h3{font-size:1.3rem}

.quote{
  font-size:clamp(1.2rem,.9rem + 1.1vw,1.7rem);
  padding:clamp(28px,3.4vw,44px) clamp(22px,3vw,40px) clamp(28px,3.4vw,44px) clamp(38px,4vw,56px);
  box-shadow:var(--shadow)
}
.quote:before{font-size:72px;left:14px}

/* ---------- table / faq (details) / media / form ---------- */
th,td{padding:14px 18px;font-size:13px}
.faq summary{padding:18px 22px}
.faq details p{padding:0 22px 18px;font-size:14px}
.imageblock{min-height:clamp(260px,34vw,360px)}
.pc-title{font-size:clamp(2rem,4vw,3.4rem)}
input,select,textarea{padding:13px 14px}
textarea{min-height:110px}

/* ---------- footer (never hidden behind the bottom banner) ---------- */
.footer{padding:clamp(44px,6vw,64px) 0 calc(var(--ban) + 28px)}
.footer .tagline{font-size:clamp(17px,1.6vw,20px);margin-top:16px}
.footerlinks{gap:14px 24px;margin:24px 0}

/* =====================================================================
   RESPONSIVE
   ===================================================================== */

/* nav fits between 1021–1200px */
@media(min-width:1021px) and (max-width:1200px){
  .nav{gap:12px}
  .navlinks{font-size:12.5px;gap:0}
  .navlinks a.lnk{padding:10px 8px}
  .navlinks a.lnk:after{left:8px;right:8px}
  .btn.nav-cta{padding:10px 16px;margin-left:6px}
}

/* short laptops (e.g. 1366×650 viewport) */
@media(min-width:1021px) and (max-height:760px){
  .hero-inner{min-height:0;padding-top:24px;padding-bottom:28px}
  .hero .mentor-net p{font-size:13.5px;margin-bottom:14px}
  .mn-grid{gap:8px}
  .mn-tile{min-height:48px;padding:7px 10px}
  .trust{margin-top:20px}
}

/* tablet + phone */
@media(max-width:1020px){
  .navlinks{
    top:var(--hdr);
    max-height:calc(100vh - var(--hdr));
    overflow-y:auto;
    padding:12px var(--gutter) 22px
  }
  .hero-inner{min-height:0;grid-template-columns:1fr}
  .split{gap:28px}
  .mentor-net{max-width:600px}
}

/* tablet: last odd card spans the full row (no orphan) */
@media(min-width:641px) and (max-width:1020px){
  .three>:last-child:nth-child(odd){grid-column:1/-1}
}

/* phones */
@media(max-width:640px){
  .hero-inner{padding-top:26px;padding-bottom:36px}
  .actions .btn{flex:1 1 100%}
  .trust span{font-size:11px;padding:7px 12px}
  .brand img{height:42px}
  .mentor-net{padding:24px 18px 18px;border-radius:22px}
}

/* =====================================================================
   HERO ALIGNMENT – left copy + right Mentor card
   (append at END of file; delete this block + the "hero-copy" class to revert)
   ===================================================================== */

/* Desktop: both columns share one row height; content centered in each */
.hero-inner{
  align-items:stretch;      /* left + right columns get equal height */
  align-content:center;     /* row hugs content, centered in the hero */
}
.hero-copy{
  display:flex;flex-direction:column;justify-content:center;
  min-width:0;
}
.hero-copy .eyebrow{align-self:flex-start}
.hero-copy h1{margin:30px 0 30px}
.hero-copy p{margin-bottom:0}
.hero-copy .actions{margin-top:35px}
.hero-copy .trust{margin-top:60px}

.mentor-net{
  display:flex;flex-direction:column;justify-content:center;
  width:100%;min-width:0;
}
.mn-body{width:100%}

/* Tablet: centered stack, same width for text and card */
@media(max-width:1020px){
  .hero-inner{align-content:start;gap:32px}
  .hero-copy{
    align-items:center;text-align:center;
    width:100%;max-width:640px;margin:0 auto;
  }
  .hero-copy .eyebrow{align-self:center}
  .hero-copy p{margin-left:auto;margin-right:auto}
  .hero-copy .actions,
  .hero-copy .trust{justify-content:center}
  .mentor-net{max-width:640px;margin:0 auto}
}

/* Phone: left-aligned text, card exactly the same width */
@media(max-width:640px){
  .hero-copy{align-items:stretch;text-align:left;max-width:none}
  .hero-copy .eyebrow{align-self:flex-start}
  .hero-copy p{margin-left:0;margin-right:0}
  .hero-copy .actions,
  .hero-copy .trust{justify-content:flex-start}
  .mentor-net{max-width:none;margin:0}
}

/* =====================================================================
   LOGO – bigger icon + THEORIA, tagline under the word with blue lines
   (append at END of file; delete this block to revert)
   Used by Header.jsx and Footer.jsx through .brand / .wordmark
   ===================================================================== */

/* one size variable drives icon, word and tagline */
.brand{
  --logo:clamp(28px,1rem + 1.5vw,40px);   /* desktop: 28px → 40px */
  gap:calc(var(--logo) * .3);
}

/* book icon (overrides the width/height attributes and the old phone rule) */
.brand svg{
  width:calc(var(--logo) * 1.8);
  height:calc(var(--logo) * 1.5);
  flex-shrink:0;
}

/* THEORIA word + tagline stacked; width = width of THEORIA */
.wordmark{
  display:flex;
  flex-direction:column;
  align-items:stretch;
  flex-shrink:0;
  font-size:var(--logo);
  letter-spacing:.12em;
  line-height:1;
  white-space:nowrap;
}

/* tagline row:  ——— RESEARCH FOR YOUNG SCHOLARS ——— */
.wordmark small{
  display:flex;
  align-items:center;
  gap:.6em;
  margin-top:calc(var(--logo) * .2);
  font-family:'DM Sans';
  font-weight:700;
  font-size:max(6.2px, calc(var(--logo) * .2));
  line-height:1;
  letter-spacing:.1em;
}

/* the two blue lines (fade outward, fill the leftover width) */
.wordmark small:before,
.wordmark small:after{
  content:"";
  flex:1 1 0;
  min-width:6px;
  height:2px;
  border-radius:2px;
}
.wordmark small:before{background:linear-gradient(90deg,rgba(91,124,240,.15),var(--blue-d))}
.wordmark small:after {background:linear-gradient(90deg,var(--blue-d),rgba(91,124,240,.15))}

/* footer sits on a dark background: lighter blue lines */
.footer .wordmark small:before{background:linear-gradient(90deg,rgba(157,190,255,.2),var(--blue))}
.footer .wordmark small:after {background:linear-gradient(90deg,var(--blue),rgba(157,190,255,.2))}

/* small laptops: keep the nav links on one line */
@media(min-width:1021px) and (max-width:1200px){
  .brand{--logo:28px}
}
/* tablet */
@media(max-width:1020px){
  .brand{--logo:34px}
}
/* phones */
@media(max-width:640px){
  .brand{--logo:clamp(26px,7.4vw,32px)}
}

/* =====================================================================
   HERO CAROUSEL (students + mentors)
   Replaces the "Our Mentor Network" card in the hero.
   All classes are prefixed "hc-". Delete this block + HeroCarousel.jsx
   to remove it. Does not depend on .rv / .spark / .ring / .dot etc.
   ===================================================================== */
.hc{
  --hc-blue:#6a7df0; --hc-purple:#9b6fe0; --hc-peri:#8fa6ff; --hc-lilac:#b28cff;
  --hc-navy:#0a0f2e; --hc-ease:cubic-bezier(.22,.8,.24,1);
  position:relative;isolation:isolate;
  align-self:center;width:100%;min-width:0;
  color:var(--hc-blue);transition:color .9s;outline:none;
  animation:hc-rise 1s .2s var(--hc-ease) both;
}
.hc[data-type="mentor"]{color:var(--hc-purple)}
.hc:focus-visible .hc-stage{outline:2px solid var(--hc-lilac);outline-offset:8px;border-radius:24px}

@keyframes hc-rise{from{opacity:0;transform:translateY(22px)}to{opacity:1;transform:none}}
@keyframes hc-spin{to{transform:rotate(360deg)}}
@keyframes hc-twinkle{0%,100%{opacity:.2;transform:scale(.7) rotate(0)}50%{opacity:.95;transform:scale(1.15) rotate(25deg)}}
@keyframes hc-float{50%{transform:translateY(-8px)}}

/* ---------- ambient layer (glow, orbits, sparkles) ---------- */
.hc-bg{position:absolute;inset:-40px -30px 30px;pointer-events:none;z-index:0}
.hc-blob{position:absolute;right:-8%;top:50%;width:92%;aspect-ratio:1;margin-top:-46%;border-radius:50%;filter:blur(46px);opacity:0;transition:opacity 1s}
.hc-b1{background:radial-gradient(circle,rgba(106,125,240,.38),transparent 66%)}
.hc-b2{background:radial-gradient(circle,rgba(155,111,224,.42),transparent 66%)}
.hc[data-type="student"] .hc-b1,
.hc[data-type="mentor"] .hc-b2{opacity:1}
.hc-orbit{position:absolute;aspect-ratio:1;border-radius:50%}
.hc-orbit svg{width:100%;height:100%;overflow:visible}
.hc-o1{width:96%;right:-14%;top:50%;margin-top:-48%;opacity:.38;animation:hc-spin 80s linear infinite}
.hc-o2{width:74%;right:-3%;top:50%;margin-top:-37%;opacity:.3;animation:hc-spin 55s linear infinite reverse}
.hc-dotgrid{position:absolute;left:4%;top:3%;width:112px;height:112px;opacity:.38;background-image:radial-gradient(currentColor 1.6px,transparent 2.2px);background-size:16px 16px}
.hc-sp{position:absolute;font-size:16px;line-height:1;color:currentColor;animation:hc-twinkle 3.4s infinite ease-in-out}
.hc-s1{right:3%;top:4%}
.hc-s2{left:10%;bottom:20%;font-size:11px;animation-delay:1.1s}
.hc-s3{right:0;bottom:24%;font-size:12px;animation-delay:2s}

/* ---------- stage ---------- */
.hc-stage{position:relative;z-index:1;height:470px;touch-action:pan-y;user-select:none;-webkit-user-select:none}
.hc-slide{position:absolute;inset:0}

/* slide in / out (direction comes from --hc-dir: 1 = forward, -1 = back) */
@keyframes hc-fade-in{from{opacity:0}}
@keyframes hc-move-in{from{transform:translateX(calc(var(--hc-dir,1) * 60px))}}
@keyframes hc-fade-out{to{opacity:0}}
@keyframes hc-move-out{to{transform:translateX(calc(var(--hc-dir,1) * -60px))}}
.hc-slide.is-active{
  z-index:2;
  animation:hc-fade-in .6s ease both, hc-move-in .9s var(--hc-ease) both;
}
.hc-slide.is-leaving{
  z-index:1;pointer-events:none;
  animation:hc-fade-out .5s ease forwards, hc-move-out .9s var(--hc-ease) forwards;
}

/* ---------- photo (arch) ---------- */
.hc-pw{position:absolute;top:14px;right:22px;bottom:0;width:min(330px,64%);animation:hc-float 7s ease-in-out infinite}
.hc-iw{position:absolute;left:0;bottom:30px;width:min(292px,86%);animation:hc-float 8s ease-in-out -2s infinite}

.hc-photo,.hc-ring{border-radius:50% 50% 30px 30px / 37% 37% 30px 30px}
.hc-photo{
  position:absolute;inset:0;overflow:hidden;border:6px solid #fff;
  background:linear-gradient(160deg,#dfe4ff,#cdbdf6);
  box-shadow:0 40px 70px -30px rgba(30,30,130,.6);
  clip-path:inset(0);
  animation:hc-photo-in 1s var(--hc-ease) .12s both;
}
.hc-photo img{
  display:block;width:100%;height:100%;object-fit:cover;object-position:center 18%;
  animation:hc-zoom 1.6s var(--hc-ease) .12s both;
}
.hc-ring{
  position:absolute;inset:0;border:1.5px solid currentColor;opacity:.5;
  transform:translate(16px,-14px);pointer-events:none;
  animation:hc-ring-in 1s var(--hc-ease) .45s both;
}
@keyframes hc-photo-in{from{clip-path:inset(100% 0 0 0)}}
@keyframes hc-zoom{from{transform:scale(1.25)}}
@keyframes hc-ring-in{from{opacity:0;transform:none}}

.hc-role{
  position:absolute;left:-30px;top:34px;display:flex;align-items:center;gap:10px;
  padding:8px 18px 8px 8px;border-radius:999px;color:#fff;
  background:linear-gradient(135deg,#6a7df0,#9b6fe0);
  box-shadow:0 14px 28px -10px rgba(80,70,200,.7);
  animation:hc-role-in .7s cubic-bezier(.34,1.56,.64,1) .55s both;
}
.hc-slide.is-mentor .hc-role{background:linear-gradient(135deg,#7a55d8,#a46be0)}
@keyframes hc-role-in{from{opacity:0;transform:translateX(-18px) scale(.9)}}
.hc-role-ico{width:32px;height:32px;border-radius:50%;display:grid;place-items:center;background:rgba(255,255,255,.22)}
.hc-role-ico svg{width:16px;height:16px}
.hc-role-title{display:block;font-size:12px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;line-height:1.2}
.hc-role-sub{display:block;font-size:11px;opacity:.88;line-height:1.3}

/* ---------- info card ---------- */
/* student = purple card */
.hc-info{
  display:grid;gap:12px;padding:16px 18px;border-radius:20px;
  background:linear-gradient(160deg,#7752d8,#5233b9);
  border:1px solid rgba(255,255,255,.2);color:#fff;
  -webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px);
  box-shadow:0 30px 56px -22px rgba(82,51,185,.75);
  animation:hc-info-in .9s var(--hc-ease) .3s both;
}
/* mentor = white card */
.hc-slide.is-mentor .hc-info{
  background:rgba(255,255,255,.9);border:1px solid #fff;
  color:var(--hc-navy);
  box-shadow:0 30px 56px -24px rgba(50,50,170,.5);
}
@keyframes hc-info-in{from{opacity:0;transform:translateY(34px) scale(.97)}}

.hc-row,.hc-sep{animation:hc-row-in .7s var(--hc-ease) calc(.5s + var(--i,0) * .12s) both}
@keyframes hc-row-in{from{opacity:0;transform:translateY(10px)}}
.hc-row{display:flex;align-items:center;gap:13px;min-width:0}
.hc-text{min-width:0}
.hc-sep{height:1px;background:linear-gradient(90deg,rgba(255,255,255,.5),transparent)}

.hc-ico{flex:none;width:40px;height:40px;border-radius:12px;display:grid;place-items:center;color:#fff;background:rgba(255,255,255,.18);box-shadow:inset 0 0 0 1px rgba(255,255,255,.24)}
.hc-ico svg{width:20px;height:20px}
.hc-degree{flex:none;width:50px;height:50px;border-radius:14px;display:grid;place-items:center;font-weight:800;font-size:13px;letter-spacing:.04em;color:#0b1038;background:linear-gradient(135deg,var(--hc-peri),var(--hc-lilac))}
.hc-label{display:block;font-size:10.5px;line-height:1.4;letter-spacing:.14em;text-transform:uppercase;font-weight:600;color:#e8e0ff}
.hc-slide.is-mentor .hc-label{color:#7a80b3}
.hc-value{display:block;font-family:'DM Sans';font-weight:500;font-size:17.5px;line-height:1.28;color:inherit}
.hc-slide.is-mentor .hc-value{font-size:19px}

/* ---------- controls ---------- */
.hc-controls{position:relative;z-index:2;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:12px 16px;margin-top:22px}
.hc-dots{display:flex;align-items:center;gap:8px}
.hc-dot,.hc-btn{appearance:none;-webkit-appearance:none;margin:0;padding:0;border:0;background:none;color:inherit}
.hc-dot{position:relative;width:8px;height:20px;display:grid;align-items:center;transition:width .5s var(--hc-ease)}
.hc-dot:before{content:"";position:absolute;inset:0 -4px}
.hc-dot-track{display:block;position:relative;height:8px;border-radius:999px;overflow:hidden;background:#c6cbee;transition:background .4s}
.hc-dot:hover .hc-dot-track{background:#9aa2e0}
.hc-dot.is-on{width:40px}
.hc-dot.is-on .hc-dot-track{background:rgba(106,125,240,.22)}
.hc-fill{position:absolute;inset:0;display:block;background:linear-gradient(90deg,var(--hc-blue),var(--hc-purple));transform:scaleX(0);transform-origin:left}

.hc-btns{display:flex;gap:8px}
.hc-btn{
  width:44px;height:44px;border-radius:50%;display:grid;place-items:center;
  background:#fff;border:1px solid #dfe2f7;color:var(--hc-navy);
  box-shadow:0 8px 18px -12px rgba(60,60,160,.5);
  transition:transform .3s var(--hc-ease),background .3s,color .3s,border-color .3s;
}
.hc-btn:hover{background:var(--hc-navy);color:#fff;border-color:var(--hc-navy);transform:translateY(-2px)}
.hc-btn svg{width:17px;height:17px}
.hc-btn:focus-visible,.hc-dot:focus-visible{outline:2px solid var(--hc-lilac);outline-offset:3px;border-radius:999px}

/* ---------- responsive ---------- */
/* short laptops */
@media(min-width:1021px) and (max-height:760px){
  .hc-stage{height:420px}
}
/* tablet: stacked + centered, same flow as .hero-copy */
@media(max-width:1020px){
  .hc{max-width:560px;margin-inline:auto}
} 
/* phones */
@media(max-width:560px){
  .hc-stage{height:430px}
  .hc-pw{width:74%;right:6px}
  .hc-iw{width:88%;bottom:22px}
  .hc-role{left:-10px;top:26px}
  .hc-info{padding:14px 16px}
  .hc-value{font-size:16px}
  .hc-slide.is-mentor .hc-value{font-size:17px}
  .hc-dots{gap:6px}
  .hc-dot.is-on{width:30px}
  .hc-btn{width:40px;height:40px}
}
@media(max-width:380px){
  .hc-dot.is-on{width:24px}
  .hc-btn{width:36px;height:36px}
}
/* your global reduced-motion rule disables animations, so hide outgoing slides instantly */
@media(prefers-reduced-motion:reduce){
  .hc-slide.is-leaving{display:none}
}


/* =====================================================================
   FIT-TO-SCREEN LAYER v2 – one screen per section, readable text
   (replaces the previous FIT-TO-SCREEN block; delete to revert)
   --u = text/size unit, --g = spacing unit (both follow the visible height)

   DIALS:
   --fit-text-ref : smaller number = BIGGER text   (try 620 bigger / 740 smaller)
   --fit-text-min : smallest allowed text scale     (try 1px bigger / .88px smaller)
   ===================================================================== */
:root{
  --fit-text-ref:680;
  --fit-text-min:.92px;
  --fit-text-max:1.28px;
  --fit-space-ref:900;

  --fit-h:calc(var(--view) - 1px);
  --u:clamp(var(--fit-text-min),min(calc(var(--fit-h) / var(--fit-text-ref)),calc(100vw / 1100)),var(--fit-text-max));
  --g:clamp(.3px,min(calc(var(--fit-h) / var(--fit-space-ref)),calc(100vw / 1100)),1px);
}
/* tablets (stacked layouts are taller) */
@media(min-width:641px) and (max-width:1020px){
  :root{
    --u:clamp(.9px,calc(var(--fit-h) / 950),1.15px);
    --g:clamp(.4px,calc(var(--fit-h) / 1000),1px);
  }
}

/* wider content area on big screens: bigger text wraps less (header, sections, footer stay aligned) */
@media(min-width:1280px){
  header .shell,section .shell,.hero .shell,.pagehead .shell,.footer .shell{max-width:1360px}
}
@media(min-width:1700px){
  header .shell,section .shell,.hero .shell,.pagehead .shell,.footer .shell{max-width:1500px}
}

@media(min-width:641px) and (min-height:520px){

  /* ---------- frame: every section fills one screen, content centered ---------- */
  html{scroll-snap-type:y proximity;scroll-padding-top:calc(var(--hdr) + 1px)}  /* remove this line to disable snapping */
  section,.hero,.pagehead{scroll-snap-align:start}

  section{
    min-height:var(--fit-h);
    display:flex;flex-direction:column;justify-content:center;
    padding:calc(18*var(--g)) 0 !important;
  }
  section > .shell{width:100%;margin:0 auto}

  .hero{min-height:var(--fit-h);display:flex;align-items:center}
  .hero .hero-inner{
    width:100%;min-height:0;margin:0 auto;
    padding-top:calc(16*var(--g));padding-bottom:calc(16*var(--g));
    row-gap:calc(20*var(--g));
  }

  .pagehead{
    min-height:var(--fit-h);
    display:flex;flex-direction:column;justify-content:center;
    padding:calc(18*var(--g)) 0 !important;
  }
  .pagehead .shell{width:100%;margin:0 auto}

  /* ---------- type ---------- */
  .eyebrow{font-size:max(11.5px,calc(12.5*var(--u)))}
  /* .hero .hero-copy h1{font-size:calc(54*var(--u));line-height:1.06;margin:calc(14*var(--g)) 0 calc(16*var(--g))}
  .hero .hero-copy p{font-size:max(15.5px,calc(17.5*var(--u)));line-height:1.58;max-width:min(100%,calc(580*var(--u)))} */
  .pagehead h1{font-size:calc(60*var(--u));line-height:1.06;}
  section h2{font-size:calc(42*var(--u));line-height:1.12;}
  section h3{font-size:calc(22*var(--u));}
  section p{font-size:max(14px,calc(16*var(--u)));line-height:1.55;}
  section .intro{font-size:max(15px,calc(17*var(--u)))}

  /* ---------- buttons / hero extras ---------- */
  /* .hero .btn,section .btn{padding:calc(13*var(--u)) calc(24*var(--u));font-size:max(13px,calc(14*var(--u)))}
  section .actions{margin-top:calc(18*var(--g));gap:calc(10*var(--g)) calc(12*var(--u))}
  .hero .hero-copy .actions{margin-top:calc(22*var(--g))}
  .hero .hero-copy .trust{
    margin-top:calc(22*var(--g));gap:calc(8*var(--g)) calc(10*var(--u));
    font-size:max(11px,calc(12*var(--u)));
  }
  .hero .trust span{padding:calc(8*var(--g)) calc(14*var(--u))} */

  .hero-art{height:calc(470*var(--u))}
  .bigicon{width:calc(230*var(--u))}
  .ring.r1{width:calc(310*var(--u));height:calc(310*var(--u))}
  .ring.r2{width:calc(400*var(--u));height:calc(400*var(--u))}

  /* ---------- cards / prices ---------- */
  .three{row-gap:calc(18*var(--g))}
  .card{padding:calc(20*var(--g)) calc(24*var(--u))}
  .card h3{font-size:calc(23*var(--u));}
  .card p{font-size:max(13px,calc(15*var(--u)));line-height:1.52}
  .card .tag{font-size:max(11px,calc(11.5*var(--u)))}
  .card ul{font-size:max(13px,calc(14.5*var(--u)))}
  .card li:before{top:calc(8*var(--u));width:calc(17*var(--u));height:calc(17*var(--u));font-size:calc(9.5*var(--u))}
  .price-amt{font-size:calc(38*var(--u))}
  .price-note{font-size:max(11px,calc(11.5*var(--u)))}
  .num-big{font-size:calc(42*var(--u))}

  /* ---------- tiles / steps / research / quote ---------- */
  .tiles{row-gap:calc(12*var(--g))}
  .tile .dot{width:calc(40*var(--u));height:calc(40*var(--u));font-size:calc(16*var(--u))}
  .tile strong{font-size:calc(17*var(--u));}
  .tile p{font-size:max(13px,calc(14.5*var(--u)))}

  .split{row-gap:calc(24*var(--g))}
  .step b{font-size:calc(30*var(--u));min-width:calc(46*var(--u))}
  .step strong{font-size:calc(17.5*var(--u))}
  .step p{font-size:max(13px,calc(14.5*var(--u)));}

  .research-grid{row-gap:calc(16*var(--g))}
  .research-card h3{font-size:calc(22*var(--u))}
  .research-card p{font-size:max(13px,calc(15*var(--u)))}
  .research-card .category{font-size:max(11px,calc(11.5*var(--u)))}
  .research-card .ico{width:calc(44*var(--u));height:calc(44*var(--u));}

  .quote{font-size:calc(27*var(--u));}
  .quote:before{font-size:calc(68*var(--u))}
  .note{font-size:max(12px,calc(12.5*var(--u)))}

  /* ---------- table: no forced width, so no inner horizontal scroll ---------- */
  th,td{font-size:max(12.5px,calc(14*var(--u)))}
  th{font-size:max(11px,calc(12*var(--u)))}

  /* ---------- FAQ ---------- */
  .faq details{margin-bottom:calc(9*var(--g))}
  .faq summary{padding:calc(14*var(--g)) calc(22*var(--u));font-size:max(14.5px,calc(16*var(--u)))}
  .faq summary:after{width:calc(30*var(--u));height:calc(30*var(--u));font-size:calc(20*var(--u))}
  .faq details p{padding:0 calc(22*var(--u)) calc(14*var(--g));font-size:max(13px,calc(14.5*var(--u)))}

  /* ---------- media block / forms ---------- */
  .pc-title{font-size:calc(58*var(--u))}
  .wave{height:calc(34*var(--u))}
  .formgrid{gap:calc(12*var(--g)) calc(14*var(--u));}
  section input,section select,section textarea{font-size:max(14px,calc(15*var(--u)))}

  /* ---------- hero carousel (sizes only; logic and animations untouched) ---------- */
  .hc-stage{height:calc(455*var(--u))}
  .hc-pw{top:calc(14*var(--g));width:min(calc(330*var(--u)),64%)}
  .hc-iw{bottom:calc(28*var(--g));width:min(calc(292*var(--u)),86%)}
  .hc-role{top:calc(32*var(--g));padding:calc(8*var(--u)) calc(18*var(--u)) calc(8*var(--u)) calc(8*var(--u))}
  .hc-role-ico{width:calc(32*var(--u));height:calc(32*var(--u))}
  .hc-role-title{font-size:max(11.5px,calc(12.5*var(--u)))}
  .hc-role-sub{font-size:max(10.5px,calc(11.5*var(--u)))}
  .hc-info{gap:calc(11*var(--g));padding:calc(15*var(--g)) calc(20*var(--u))}
  .hc-row{gap:calc(13*var(--u))}
  .hc-ico{width:calc(42*var(--u));height:calc(42*var(--u))}
  .hc-degree{width:calc(52*var(--u));height:calc(52*var(--u));font-size:max(12px,calc(14*var(--u)))}
  .hc-label{font-size:max(10.5px,calc(11*var(--u)))}
  .hc-value{font-size:max(16px,calc(19*var(--u)))}
  .hc-slide.is-mentor .hc-value{font-size:max(17px,calc(20.5*var(--u)))}
  .hc-controls{margin-top:calc(18*var(--g))}
  .hc-btn{width:max(40px,calc(46*var(--u)));height:max(40px,calc(46*var(--u)))}
}


/* =====================================================================
   THEME COLOURS – page background #F3F1E5, primary text #133B3A
   (append AFTER everything; delete this block to go back to the old colours)
   Only colours change here. Sizes, spacing, animations are untouched.
   ===================================================================== */
:root{
  --page:#F3F1E5;          /* website background */
  --card:#FBFAF4;          /* cards, inputs, panels (lighter than page) */
  --navy:#084d4b;          /* primary font colour (also buttons, dark sections) */
  /* --navy:#123B37;          /* primary font colour (also buttons, dark sections) */
  --navy-2:#0F2F2E;
  --navy-3:#24605C;
  --ink:#133B3A;
  --muted:#4D6967;         /* paragraph text */
  --ivory:#F3F1E5;         /* hero + page head background */
  --tint:#E8E5D2;
  --line:#DAD6C0;
  --line-2:#C9C5AA;        /* hover / open borders */
  --shadow:0 18px 50px -18px rgba(19,59,58,.28);

  /* accent colours – green tints of #133B3A (replace old blue / purple) */
  --blue:#A9CBBF;          /* light tint  (gradient start) */
  --purple:#6FA89A;        /* mid tint    (gradient end)   */
  --blue-d:#2F6B66;        /* deeper shade */
  --purple-d:#24605C;      /* links, hover text, icons */
  --grad:#018a86;
  /* --grad:#123B37; */
}

/* ---------- base ---------- */
body{background:var(--page);color:var(--ink)}
.eyebrow{color:#2F5A57}
.dark .eyebrow{color:var(--blue)}
::selection{background:rgba(111,168,154,.35)}

/* ---------- header / mobile menu ---------- */
header{background:rgba(243,241,229,.93)}
@media(max-width:1020px){
  .navlinks{background:var(--page);box-shadow:0 20px 30px -20px rgba(19,59,58,.3)}
}

/* ---------- buttons ---------- */
.btn:hover{box-shadow:0 14px 30px -10px rgba(19,59,58,.5)}
.btn.secondary{border-color:#8FA6A0}
.btn.pastel:hover{box-shadow:0 14px 30px -10px rgba(63,130,119,.6)}

/* ---------- sections ---------- */
.band{background:linear-gradient(100deg,#ECE9D6,#F7F5EB)}
.dark p{color:#CBDAD4}
.hero{
  background:
    radial-gradient(rgba(19,59,58,.10) 1px,transparent 1.6px) 0 0/22px 22px,
    var(--ivory);
}
.trust{color:#2E4F4D}
.trust span{background:rgba(251,250,244,.8);box-shadow:0 8px 20px -14px rgba(19,59,58,.4)}
.hero-art{
  background:linear-gradient(160deg,#0C2827 5%,#133B3A 55%,#4C8A83 120%);
  box-shadow:0 30px 70px -20px rgba(19,59,58,.5);
}
.hero-art .ring{border:1.5px solid rgba(169,203,191,.55);border-left-color:transparent}
.hero-art .caption{color:#E9EFE6}

/* ---------- page head (inner pages) ---------- */
.pagehead:before{background:radial-gradient(circle,rgba(111,168,154,.28),rgba(169,203,191,.2) 45%,transparent 70%)}

/* ---------- cards ---------- */
.card{background:var(--card)}
.card:hover{border-color:var(--line-2)}
.card .tag{color:#3E6461}
.card.featured{
  background:linear-gradient(160deg,#F9F7EC,#EFEBD8);border-color:#D2CDAF;
  box-shadow:0 26px 50px -30px rgba(19,59,58,.45)
}
.card.fellow{box-shadow:0 26px 50px -30px rgba(12,40,39,.6)}
.card.fellow p,.card.fellow .tag{color:#CFE0DA}
.card.fellow .price-note{color:#CFE0DA}
.card.featured .price{border-color:#D2CDAF}
.price-note{color:#3E6461}
.num-big{color:#B7C4B3}

.tile{background:var(--card)}
.band .tile{background:rgba(251,250,244,.78)}

.quote{background:linear-gradient(135deg,#EBE8D5,#F5F2E4)}

.mutedbox{background:#EDEAD9}

.research-card{background:var(--card)}
.research-card .category{color:#3E6461}

.note{color:#4F6967;background:rgba(111,168,154,.12)}
.hl{background:linear-gradient(180deg,rgba(111,168,154,.12),transparent)}

/* ---------- table ---------- */
.tablewrap{background:var(--card);box-shadow:0 10px 30px -18px rgba(19,59,58,.25)}
tbody tr:hover{background:#EFEDDD}

/* ---------- faq (css version) ---------- */
.faq details{background:var(--card)}
.faq details[open]{border-color:var(--line-2)}
.source{color:var(--purple-d)}

/* ---------- media block / form ---------- */
.imageblock{background:linear-gradient(140deg,#D2E1D6,#EBE5CC)}
.play{box-shadow:0 14px 30px -8px rgba(19,59,58,.55)}
input,select,textarea{background:var(--card);border-color:#CFCBB2;color:var(--ink)}
input:focus,select:focus,textarea:focus{box-shadow:0 0 0 4px rgba(111,168,154,.25)}

/* ---------- footer ---------- */
.footer{background:var(--navy);color:var(--page)}
.footer:before{background:var(--navy)}
.footer .tagline{color:var(--page)}
.footerlinks a{color:var(--page)}
.footer hr{border-top-color:var(--line)}
.footer .copy{color:var(--page)}

/* ---------- old mentor card (if still used anywhere) ---------- */
.mentor-net{
  background:linear-gradient(160deg,#0C2827 5%,#133B3A 58%,#2C625E 130%);
  box-shadow:0 30px 70px -20px rgba(19,59,58,.5);
}
.mn-ring{border:1.5px solid rgba(169,203,191,.45);border-left-color:transparent;border-bottom-color:rgba(111,168,154,.75)}
.mn-tile:after{box-shadow:0 0 0 2px rgba(111,168,154,.95),0 0 22px rgba(169,203,191,.6)}
.hero .mentor-net p{color:#CFE0DA}
.mn-disclaimer{color:#9DB5B0}

/* ---------- hero carousel (colours only) ---------- */
.hc{
  --hc-blue:#3F8277;       /* ambient colour on student slide */
  --hc-purple:#2A6A63;     /* ambient colour on mentor slide  */
  --hc-peri:#A9CBBF;
  --hc-lilac:#6FA89A;
  --hc-navy:#133B3A;
}
.hc-b1{background:radial-gradient(circle,rgba(63,130,119,.30),transparent 66%)}
.hc-b2{background:radial-gradient(circle,rgba(42,106,99,.32),transparent 66%)}
.hc-photo{
  background:linear-gradient(160deg,#E3EBDD,#BFD3C4);
  box-shadow:0 40px 70px -30px rgba(19,59,58,.55)
}
.hc-slide.is-mentor .hc-info{
  background:rgba(251,250,244,.92);border-color:#E6E2CE;
  box-shadow:0 30px 56px -24px rgba(19,59,58,.45)
}
.hc-slide.is-mentor .hc-label{color:#5F7A77}
.hc-degree{color:#133B3A}
.hc-dot-track{background:#CFCBB2}
.hc-dot:hover .hc-dot-track{background:#A9B4A4}
.hc-dot.is-on .hc-dot-track{background:rgba(47,107,102,.22)}
.hc-btn{background:var(--card);border-color:var(--line);box-shadow:0 8px 18px -12px rgba(19,59,58,.4)}

/* student card + role badges (delete this small group to get the old purple back) */
.hc-info{
  background:linear-gradient(160deg,#2A6A63,#133B3A);
  box-shadow:0 30px 56px -22px rgba(19,59,58,.75)
}
.hc-label{color:#DCEBE5}
.hc-role{
  background:linear-gradient(135deg,#2F6B66,#1B4B48);
  box-shadow:0 14px 28px -10px rgba(19,59,58,.6)
}
.hc-slide.is-mentor .hc-role{background:linear-gradient(135deg,#133B3A,#2A6A63)}

/* ---------- Tailwind classes used in CommonQuestions.jsx / BottomBanner.jsx ---------- */
section.bg-white{background-color:var(--page)}
section .bg-white{background-color:var(--card)}
body .bg-white\/95{background-color:rgba(243,241,229,.95)}
body .bg-tint{background-color:var(--tint)}
body .border-line{border-color:var(--line)}
body .text-navy{color:var(--navy)}
body .text-ink{color:var(--ink)}
body .text-muted{color:var(--muted)}
body .shadow-card{box-shadow:var(--shadow)}
body .text-\[\#B7C3F2\]{color:#B7C4B3}
body .text-\[\#A9BBA8\]{color:#B7C4B3}
body .border-\[\#cdd6f5\]{border-color:var(--line-2)}
body .hover\:border-\[\#cdd6f5\]:hover{border-color:var(--line-2)}
body .text-brand-purple,body .text-brand-purple-d{color:var(--purple-d)}
body .bg-grad{background-image:var(--grad)}

/* =====================================================================
   LOGO – follows the theme (#133B3A on light, #F3F1E5 on the dark footer)
   ===================================================================== */
header .wordmark{color:var(--navy) !important}
.wordmark small:before,
.wordmark small:after{background:var(--navy) !important}

.footer .wordmark{color:var(--page) !important}
.footer .wordmark small:before,
.footer .wordmark small:after{background:var(--page) !important}
/* book icon colour only (shape untouched) */
.brand svg{filter:url(#ic-green)}
.footer .brand svg{filter:url(#ic-cream)}

.wordmark{
  font-weight:800;
  -webkit-text-stroke:.035em currentColor;   /* thickens the letters; follows green/cream automatically */
}
.wordmark small{
  font-weight:700;
  -webkit-text-stroke:0;                     /* keep the tagline exactly as it was */
}

/* =====================================================================
   LOGO EXPERIMENT – header only
   Row 1: book icon + THEORIA (centered on each other)
   Row 2: ——— RESEARCH FOR YOUNG SCHOLARS ——— under the whole logo
   Delete this block to go back to the previous header logo.
   ===================================================================== */
header .brand{
  display:grid;
  grid-template-columns:auto auto;
  justify-content:start;
  align-items:center;
  column-gap:calc(var(--logo) * .3);
  row-gap:calc(var(--logo) * .16);
}



/* icon: row 1, left (same 1.2 : 1 shape as before, a bit smaller so the header fits) */
header .brand svg{
  grid-column:1;
  grid-row:1;
  width:calc(var(--logo) * 1.38);
  height:calc(var(--logo) * .9);
}

footer .brand svg{
  grid-column:1;
  grid-row:1;
  width:calc(var(--logo) * 1.38);
  height:calc(var(--logo) * .9);
}

/* let THEORIA and the tagline sit directly in the grid
   (THEORIA lands in row 1 next to the icon) */
header .wordmark{display:contents}

/* tagline: row 2, spans icon + word, so the two lines stretch under the full logo */
/* tagline: row 2, only under THEORIA (left line starts at T, right line ends at A) */
header .wordmark small{
  grid-column:2;
  grid-row:2;
  margin-top:0;
  margin-right:calc(var(--logo) * .12);   /* cancels the trailing letter-spacing after the last "A" */
}

/* =====================================================================
   LOGO – follows the theme (#043837 on light)
   ===================================================================== */
header .wordmark{color:var(--navy) !important}
.wordmark small:before,
.wordmark small:after{background:var(--navy) !important}

/* footer is cream now, so its logo uses the same green (cream on cream was invisible) */
.footer .wordmark{color:var(--page) !important}

.wordmark{
  font-weight:800;
  -webkit-text-stroke:.035em currentColor;   /* thickens the letters; follows the logo colour automatically */
}
.wordmark small{
  font-weight:700;
  -webkit-text-stroke:0;                     /* keep the tagline exactly as it was */
}

/* =====================================================================
   HOME: MENTOR NETWORK (university logos) + NUMBERS (stats)
   Classes: mu-*  and  st-*   (delete this block to remove both looks)
   ===================================================================== */

/* ---------- shared: compact sections (override the one-screen min-height) ---------- */
.mu-section,
.st-section{min-height:0;overflow:hidden}

/* ---------- MENTOR NETWORK ---------- */
.mu-section{
  background:var(--page);
  border-top:1px solid var(--line);
  padding:clamp(34px,4.5vw,56px) 0 !important;
  scroll-snap-align:none;
}

/* title: left aligned, thin line fills the rest of the row */
.mu-head{margin:0 0 clamp(16px,2.2vw,26px)}
.mu-head h2{
  flex:none;margin:0;white-space:nowrap;text-align:left;
  font-size:clamp(1.55rem,1.1rem + 1.5vw,2.3rem);line-height:1.1;
}
.mu-rule{
  flex:1 1 auto;min-width:24px;height:2px;border-radius:2px;
  background:linear-gradient(90deg,var(--grad),transparent);
  transform-origin:left;
}
.rv.in .mu-rule{animation:mu-line 1s .3s var(--ease) both}

.mu-rows{display:grid;gap:clamp(10px,1.4vw,16px)}
.mu-row{position:relative}

/* desktop: 5 + 5 cards in two rows */
.mu-track{
  list-style:none;margin:0;padding:0;
  display:grid;grid-template-columns:repeat(var(--cols,5),minmax(0,1fr));
  gap:clamp(10px,1.2vw,16px);
}
.mu-card.is-dup{display:none}

/* card: logo + university name side by side */
.mu-card{
  position:relative;display:flex;align-items:center;gap:12px;min-width:0;
  min-height:68px;padding:10px 14px 10px 10px;
  background:var(--card);border:1px solid var(--line);border-radius:16px;
  transition:transform .35s var(--ease),box-shadow .35s,border-color .35s;
}
.mu-card:hover{transform:translateY(-4px);box-shadow:var(--shadow);border-color:var(--line-2)}
.mu-card:after{
  content:"";position:absolute;left:16px;right:16px;top:0;height:3px;
  border-radius:0 0 3px 3px;background:var(--grad);
  transform:scaleX(0);transform-origin:left;transition:transform .4s var(--ease);
}
.mu-card:hover:after{transform:scaleX(1)}
.rv.in .mu-card{animation:mu-pop .6s var(--ease) backwards;animation-delay:calc(var(--i,0) * 70ms + 200ms)}

.mu-logo{
  position:relative;flex:none;width:46px;height:46px;padding:0;display:block;
  overflow:hidden;
  background:#fff;border:1px solid var(--line);border-radius:13px;
  transition:transform .4s var(--ease);
}
.mu-card:hover .mu-logo{transform:scale(1.08) rotate(-3deg)}
.mu-logo img{
  position:absolute;inset:5px;
  width:calc(100% - 10px);height:calc(100% - 10px);
  max-width:none;max-height:none;
  object-fit:contain;object-position:center;display:block;
}
.mu-mono{
  position:absolute;inset:5px;width:auto;height:auto;border-radius:9px;
  display:grid;place-items:center;
  background:var(--grad);color:var(--page);font-weight:700;font-size:12px;letter-spacing:.02em;
}
.mu-name{
  min-width:0;font-size:clamp(12px,.3vw + 10.5px,13.5px);font-weight:700;
  line-height:1.3;color:var(--navy);text-wrap:balance;
}

/* tablets + phones (and small laptops): the two rows glide in opposite directions */
@media(max-width:1099px){
  .mu-rows{gap:0}
  .mu-row{
    overflow:hidden;padding:8px 0;
    -webkit-mask-image:linear-gradient(90deg,transparent,#000 6%,#000 94%,transparent);
            mask-image:linear-gradient(90deg,transparent,#000 6%,#000 94%,transparent);
  }
  .mu-track{display:flex;width:max-content;gap:0;animation:mu-scroll 34s linear infinite}
  .mu-row.rev .mu-track{animation-direction:reverse;animation-duration:40s}
  .mu-card,
  .mu-card.is-dup{display:flex;flex:none;width:clamp(210px,50vw,250px);margin-right:12px}
  .mu-row:hover .mu-track{animation-play-state:paused}
}

/* reduced motion: no scrolling, every logo shown in a wrapped grid */
@media(prefers-reduced-motion:reduce) and (max-width:1099px){
  .mu-row{overflow:visible;-webkit-mask-image:none;mask-image:none;padding:0}
  .mu-rows{gap:10px}
  .mu-track{width:auto;flex-wrap:wrap;gap:10px}
  .mu-card{width:calc(50% - 5px);margin-right:0}
  .mu-card.is-dup{display:none}
}

/* desktop: sizes follow the fit-to-screen unit, one card at a time lights its top bar */
@media(min-width:1100px) and (min-height:520px){
  .mu-head h2{font-size:calc(34*var(--u))}
  .mu-card{min-height:calc(66*var(--u));padding:calc(9*var(--g)) calc(14*var(--u)) calc(9*var(--g)) calc(10*var(--u))}
  .mu-logo{width:calc(46*var(--u));height:calc(46*var(--u))}
  .mu-name{font-size:max(12px,calc(16*var(--u)))}
}
@media(min-width:1100px){
  .mu-card:after{animation:mu-glow 12s ease-in-out infinite;animation-delay:calc(var(--i,0) * 1.2s + 2s)}
  .mu-card:hover:after{animation:none;transform:scaleX(1)}
}
@keyframes mu-glow{0%{transform:scaleX(0)}4%,10%{transform:scaleX(1)}14%,100%{transform:scaleX(0)}}

/* ---------- NUMBERS ---------- */
.st-section{
  background:
    radial-gradient(rgba(243,241,229,.08) 1px,transparent 1.6px) 0 0/22px 22px,
    var(--navy);
  color:var(--page);
  padding:clamp(34px,4.5vw,56px) 0 !important;
  scroll-snap-align:none;
}
.st-section:before,
.st-section:after{content:"";position:absolute;width:420px;height:420px;border-radius:50%;pointer-events:none}
.st-section:before{right:-140px;top:-190px;background:radial-gradient(circle,rgba(169,203,191,.2),transparent 68%)}
.st-section:after{left:-160px;bottom:-230px;background:radial-gradient(circle,rgba(111,168,154,.18),transparent 68%)}
.st-section > .shell{position:relative;z-index:1}

/* title: left aligned, thin line fills the rest of the row */
.st-head{display:flex;align-items:center;gap:clamp(14px,2vw,24px);margin:0 0 clamp(16px,2.2vw,26px)}
.st-head h2{
  flex:0 1 auto;margin:0;color:#fff;text-align:left;
  font-size:clamp(1.4rem,1rem + 1.5vw,2.2rem);line-height:1.18;
}
.st-x{
  display:inline-block;margin-right:.3em;padding:.02em .28em .08em;border-radius:.28em;
  background:var(--blue);color:var(--navy);font-weight:700;line-height:1.05;
}
.rv.in .st-x{animation:st-pop .8s .35s var(--ease) both}
.st-rule{
  flex:1 1 auto;min-width:24px;height:2px;border-radius:2px;
  background:linear-gradient(90deg,var(--blue),transparent);
  transform-origin:left;
}
.rv.in .st-rule{animation:mu-line 1s .3s var(--ease) both}

/* cards: one slim row of three */
.st-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(10px,1.4vw,16px)}
.st-grid > div{min-width:0}

.st-card{
  position:relative;height:100%;overflow:hidden;
  display:flex;align-items:center;gap:clamp(12px,1.4vw,18px);
  min-height:88px;padding:14px clamp(14px,1.6vw,22px) 17px;border-radius:18px;
  background:linear-gradient(160deg,rgba(255,255,255,.10),rgba(255,255,255,.03));
  border:1px solid rgba(255,255,255,.16);
  transition:transform .35s var(--ease),border-color .35s,box-shadow .35s;
}
.st-card:before{
  content:"";position:absolute;inset:0;z-index:0;pointer-events:none;
  background:radial-gradient(circle at 100% 0,rgba(169,203,191,.24),transparent 58%);
  opacity:0;transition:opacity .4s;
}
.st-card:hover{transform:translateY(-5px);border-color:rgba(169,203,191,.55);box-shadow:0 22px 40px -24px rgba(0,0,0,.55)}
.st-card:hover:before{opacity:1}

/* icon tile with a soft pulse ring */
.st-ico{
  position:relative;z-index:1;flex:none;width:46px;height:46px;border-radius:14px;
  display:grid;place-items:center;
  color:var(--blue);background:rgba(169,203,191,.14);box-shadow:inset 0 0 0 1px rgba(169,203,191,.3);
  transition:transform .35s var(--ease),background .35s,color .35s;
}
.st-ico svg{width:23px;height:23px}
.st-ico:after{
  content:"";position:absolute;inset:0;border-radius:inherit;pointer-events:none;
  border:1.5px solid var(--blue);opacity:0;
  animation:st-ping 3.6s ease-out infinite;animation-delay:calc(var(--i,0) * .7s + 1.6s);
}
.st-card:hover .st-ico{transform:rotate(-6deg) scale(1.08);background:var(--blue);color:var(--navy)}

/* label above, number + unit below */
.st-body{position:relative;z-index:1;min-width:0}
.st-label{
  margin:0 0 4px;color:var(--blue);font-size:.78rem;font-weight:700;line-height:1.25;
  letter-spacing:.14em;text-transform:uppercase;
}
.st-num{display:flex;flex-wrap:wrap;align-items:baseline;gap:2px 10px;margin:0;color:#fff}
.st-value{
  font-size:clamp(2.2rem,1.5rem + 2vw,3rem);font-weight:600;color:#fff;
  line-height:1;letter-spacing:-.03em;font-variant-numeric:tabular-nums;
}
.st-unit{color:var(--page);opacity:.8;font-size:.72rem;font-weight:700;letter-spacing:.18em;text-transform:uppercase}

/* bottom progress line: fills once, then a light sweep repeats */
.st-line{
  position:absolute;z-index:1;left:0;right:0;bottom:0;height:3px;overflow:hidden;
  background:rgba(255,255,255,.12);
}
.st-line:after{content:"";position:absolute;inset:0;background:var(--blue);transform-origin:left}
.rv.in .st-line:after{animation:st-fill 1.4s .45s var(--ease) both}
.st-line:before{
  content:"";position:absolute;z-index:1;top:0;bottom:0;left:0;width:34%;
  background:linear-gradient(90deg,transparent,rgba(255,255,255,.75),transparent);
  transform:translateX(-120%);
  animation:st-sweep 4s ease-in-out infinite;animation-delay:calc(var(--i,0) * .6s + 2.2s);
}

/* phones: one column of slim cards */
@media(max-width:760px){
  .st-grid{grid-template-columns:1fr}
  .st-card{min-height:76px}
}
@media(max-width:900px){
  .st-rule{display:none}
}

/* desktop + tablet landscape: sizes follow the fit-to-screen unit */
@media(min-width:761px) and (min-height:520px){
  .st-head h2{font-size:calc(34*var(--u))}
  .st-card{min-height:calc(88*var(--u))}
  .st-ico{width:calc(48*var(--u));height:calc(48*var(--u))}
  .st-label{font-size:max(11.5px,calc(12.5*var(--u)))}
  .st-value{font-size:calc(46*var(--u))}
  .st-unit{font-size:max(11px,calc(11.5*var(--u)))}
}

/* ---------- keyframes ---------- */
@keyframes mu-pop{from{opacity:0;transform:translateY(16px) scale(.94)}}
@keyframes mu-line{from{transform:scaleX(0)}}
@keyframes mu-scroll{to{transform:translateX(-50%)}}
@keyframes st-pop{from{opacity:0;transform:scale(.6)}}
@keyframes st-fill{from{transform:scaleX(0)}}
@keyframes st-ping{0%{opacity:.7;transform:scale(1)}70%,100%{opacity:0;transform:scale(1.55)}}
@keyframes st-sweep{0%{transform:translateX(-120%)}35%,100%{transform:translateX(320%)}}

/* =====================================================================
   HEADER LAYOUT – logo on the far left, nav items on the far right
   (append at END of file; delete this block to go back to the centred header)
   Only the header's inner container changes. Other sections keep their
   centred .shell.
   ===================================================================== */
header{--hdr-pad:clamp(18px,3.2vw,56px)}   /* dial: space at the screen edges */

header .shell.nav{
  width:100%;
  max-width:none;                 /* beats the 1360px / 1500px header caps */
  margin:0;
  padding-left:var(--hdr-pad);
  padding-right:var(--hdr-pad);
  justify-content:space-between;  /* logo left, nav right */
}

/* desktop: push the nav group to the right edge */
@media(min-width:1021px){
  header .navlinks{margin-left:auto}
}

/* tablet + phone: the opened menu lines up with the new header padding */
@media(max-width:1020px){
  header .navlinks{
    padding-left:var(--hdr-pad);
    padding-right:var(--hdr-pad);
  }
}

.bottomBanner .shell{
  max-width: 100%;
}

/* =====================================================================
   HERO PAPERS CAROUSEL (research paper + student pill)
   All classes are prefixed "rp-". Delete this block + HeroPapers.jsx
   (+ the <HeroPapers/> line in Home.jsx) to remove it.
   Colours come from your theme variables (--navy, --line, --card ...).
   ===================================================================== */
.rp{
  --rp-ease:cubic-bezier(.22,.8,.24,1);
  --rp-soft:var(--blue,#A9CBBF);
  position:relative;isolation:isolate;
  align-self:center;width:100%;min-width:0;
  color:var(--blue-d,#2F6B66);
  animation:rp-rise 1s .15s var(--rp-ease) both;
}

@keyframes rp-rise{from{opacity:0;transform:translateY(22px)}to{opacity:1;transform:none}}
@keyframes rp-float{50%{transform:translateY(-9px)}}
@keyframes rp-twinkle{0%,100%{opacity:.25;transform:scale(.7) rotate(0)}50%{opacity:1;transform:scale(1.15) rotate(25deg)}}
@keyframes rp-sway{50%{transform:rotate(-17deg)}}
@keyframes rp-breathe{50%{transform:scale(1.05)}}

/* ---------- ambient layer ---------- */
.rp-bg{inset:-20px -24px 70px;pointer-events:none;z-index:0}
.rp-blob{
  position:absolute;right:-3%;top:50%;width:88%;aspect-ratio:1;margin-top:-44%;
  border-radius:52% 48% 50% 50% / 46% 54% 46% 54%;
  background:radial-gradient(circle at 38% 32%,rgba(169,203,191,.75),rgba(169,203,191,.38) 55%,rgba(169,203,191,.12) 82%);
  animation:rp-breathe 12s ease-in-out infinite;
}
.rp-dotgrid{
  position:absolute;left:2%;top:2%;width:104px;height:104px;opacity:.35;
  background-image:radial-gradient(currentColor 1.6px,transparent 2.2px);background-size:16px 16px;
}
.rp-orbit{
  position:absolute;left:-8%;top:50%;width:116%;height:auto;margin-top:-29%;overflow:visible;
  opacity:.5;transform:rotate(-22deg);animation:rp-sway 20s ease-in-out infinite;
}
.rp-sp{position:absolute;width:26px;height:26px;color:var(--navy);animation:rp-twinkle 3.4s infinite ease-in-out}
.rp-s1{right:0;top:12%}
.rp-s2{left:4%;bottom:22%;width:34px;height:34px;color:var(--blue-d,#2F6B66);animation-delay:1.1s}
.rp-s3{right:8%;top:36%;width:14px;height:14px;animation-delay:2s}

/* ---------- stage + slides ---------- */
.rp-stage{position:relative;z-index:1;height:460px;touch-action:pan-y;user-select:none;-webkit-user-select:none}
.rp-slide{position:absolute;inset:0}

@keyframes rp-fade-in{from{opacity:0}}
@keyframes rp-move-in{from{transform:translateX(calc(var(--rp-dir,1) * 70px))}}
@keyframes rp-fade-out{to{opacity:0}}
@keyframes rp-move-out{to{transform:translateX(calc(var(--rp-dir,1) * -70px))}}
.rp-slide.is-active{z-index:2;animation:rp-fade-in .6s ease both,rp-move-in .9s var(--rp-ease) both}
.rp-slide.is-leaving{z-index:1;pointer-events:none;animation:rp-fade-out .5s ease forwards,rp-move-out .9s var(--rp-ease) forwards}

/* ---------- paper ---------- */
.rp-pw{position:absolute;top:0;right:10%;width:min(320px,64%);animation:rp-float 7s ease-in-out infinite}

.rp-paper{
  position:relative;isolation:isolate;display:block;width:100%;aspect-ratio:1/1.3;
  padding:0;margin:0;border:0;background:none;cursor:zoom-in;
  -webkit-appearance:none;appearance:none;
  transform:perspective(1400px) rotateY(-16deg) rotateX(5deg) rotate(-6deg);
  transform-origin:50% 60%;
  transition:transform .7s var(--rp-ease);
  animation:rp-paper-in 1s var(--rp-ease) .1s backwards;
}
.rp-paper:hover,
.rp-paper:focus-visible{
  transform:perspective(1400px) rotateY(-5deg) rotateX(2deg) rotate(-2deg) translateY(-6px) scale(1.02);
  outline:none;
}
.rp-paper:focus-visible .rp-sheet{box-shadow:0 0 0 3px var(--purple,#6FA89A),0 36px 60px -26px rgba(8,77,75,.55)}
@keyframes rp-paper-in{from{opacity:0;transform:perspective(1400px) rotateY(-28deg) rotateX(8deg) rotate(-14deg) scale(.88)}}

/* two sheets stacked behind the paper */
.rp-paper:before,
.rp-paper:after{
  content:"";position:absolute;inset:0;z-index:-1;border-radius:12px;
  background:#fff;border:1px solid rgba(8,77,75,.12);
  box-shadow:0 20px 30px -20px rgba(8,77,75,.4);
}
.rp-paper:before{transform:translate(14px,-10px) rotate(3deg);opacity:.85}
.rp-paper:after{transform:translate(28px,-18px) rotate(6deg);opacity:.55}

.rp-sheet{
  position:absolute;inset:0;overflow:hidden;border-radius:12px;background:#fff;
  border:1px solid rgba(8,77,75,.14);
  box-shadow:0 36px 60px -26px rgba(8,77,75,.55);
}
.rp-sheet img{
  display:block;width:100%;height:100%;object-fit:cover;object-position:top center;
  animation:rp-zoom 1.4s var(--rp-ease) .1s backwards;
}
@keyframes rp-zoom{from{transform:scale(1.14)}}
.rp-shine{
  position:absolute;inset:0;pointer-events:none;
  background:linear-gradient(115deg,transparent 35%,rgba(255,255,255,.6) 50%,transparent 65%);
  transform:translateX(-120%);animation:rp-shine 6s ease-in-out 1.8s infinite;
}
@keyframes rp-shine{0%{transform:translateX(-120%)}30%,100%{transform:translateX(120%)}}

.rp-zoom{
  position:absolute;top:10px;right:10px;width:36px;height:36px;border-radius:50%;
  display:grid;place-items:center;background:var(--navy);color:#fff;
  box-shadow:0 10px 20px -8px rgba(8,77,75,.7);
  transition:transform .35s var(--rp-ease);
}
.rp-zoom svg{width:16px;height:16px}
.rp-paper:hover .rp-zoom{transform:scale(1.12)}

/* green tag overlapping the paper */
.rp-tag{
  position:absolute;left:-16%;bottom:12%;z-index:2;max-width:64%;
  padding:11px 16px 12px;border-radius:12px;color:#fff;
  background:linear-gradient(150deg,var(--navy),#0F2F2E);
  box-shadow:0 20px 34px -16px rgba(8,77,75,.75);
  transform:rotate(-6deg);
  animation:rp-tag-in .8s cubic-bezier(.34,1.56,.64,1) .55s backwards;
}
@keyframes rp-tag-in{from{opacity:0;transform:translateX(-22px) rotate(-6deg) scale(.9)}}
.rp-tag small{display:block;font-size:10px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;opacity:.75;line-height:1.3}
.rp-tag strong{display:block;margin-top:3px;font-size:15px;font-weight:600;line-height:1.28}

/* ---------- student pill ---------- */
.rp-pill{
  position:absolute;z-index:3;right:0;bottom:24px;max-width:100%;
  display:flex;align-items:center;gap:14px;
  padding:8px clamp(18px,2vw,28px) 8px 8px;border-radius:25px;
  background:rgba(251,250,244,.96);border:1px solid var(--line);
  -webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);
  box-shadow:0 24px 44px -20px rgba(8,77,75,.5);
  animation:rp-pill-in .8s var(--rp-ease) .55s backwards;
}
@keyframes rp-pill-in{from{opacity:0;transform:translateY(30px) scale(.94)}}
.rp-av{
  position:relative;flex:none;width:64px;height:64px;border-radius:50%;
  background:linear-gradient(160deg,#E3EBDD,#BFD3C4);
  box-shadow:0 0 0 3px #fff,0 0 0 4px rgba(8,77,75,.18);
}
.rp-av img{display:block;width:100%;height:100%;border-radius:50%;object-fit:cover;object-position:center 20%}
.rp-av:after{
  content:"";position:absolute;inset:-3px;border-radius:50%;pointer-events:none;
  border:2px solid var(--blue-d,#2F6B66);opacity:0;animation:rp-ping 3.6s ease-out 1.6s infinite;
}
@keyframes rp-ping{0%{opacity:.6;transform:scale(1)}70%,100%{opacity:0;transform:scale(1.4)}}
.rp-mono{
  width:100%;height:100%;border-radius:50%;display:grid;place-items:center;
  background:var(--grad);color:var(--page);font-weight:700;font-size:18px;letter-spacing:.03em;
}
.rp-who{min-width:0}
.rp-who strong{
  display:block;font-size:19px;font-weight:600;line-height:1.2;color:var(--navy);
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
}
.rp-who span{
  display:block;margin-top:2px;font-size:13.5px;line-height:1.3;color:var(--muted);
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
}

/* ---------- controls ---------- */
.rp-controls{
  position:relative;z-index:2;display:flex;flex-wrap:wrap;align-items:center;
  justify-content:space-between;gap:12px 16px;margin-top:20px;
}
.rp-dots{display:flex;align-items:center;gap:8px}
.rp-dot,.rp-btn{appearance:none;-webkit-appearance:none;margin:0;padding:0;border:0;background:none;color:inherit}
.rp-dot{position:relative;width:8px;height:20px;display:grid;align-items:center;transition:width .5s var(--rp-ease)}
.rp-dot:before{content:"";position:absolute;inset:0 -4px}
.rp-dot-track{display:block;position:relative;height:8px;border-radius:999px;overflow:hidden;background:var(--line-2,#C9C5AA);transition:background .4s}
.rp-dot:hover .rp-dot-track{background:#A9B4A4}
.rp-dot.is-on{width:40px}
.rp-dot.is-on .rp-dot-track{background:rgba(8,77,75,.2)}
.rp-fill{position:absolute;inset:0;display:block;background:var(--navy);transform:scaleX(0);transform-origin:left}
.rp-dot.is-on .rp-fill{animation:rp-progress var(--rp-time,6500ms) linear forwards}
.rp[data-paused="true"] .rp-fill{animation-play-state:paused}
@keyframes rp-progress{to{transform:scaleX(1)}}

.rp-right{display:flex;align-items:center;gap:14px}
.rp-count{font-size:13px;letter-spacing:.12em;font-weight:700;color:var(--muted);font-variant-numeric:tabular-nums}
.rp-count b{color:var(--navy);font-weight:800}
.rp-count i{font-style:normal;margin:0 4px;opacity:.5}
.rp-btns{display:flex;gap:8px}
.rp-btn{
  width:44px;height:44px;border-radius:50%;display:grid;place-items:center;
  background:var(--card);border:1px solid var(--line);color:var(--navy);
  box-shadow:0 8px 18px -12px rgba(8,77,75,.45);
  transition:transform .3s var(--rp-ease),background .3s,color .3s,border-color .3s;
}
.rp-btn:hover{background:var(--navy);color:#fff;border-color:var(--navy);transform:translateY(-2px)}
.rp-btn svg{width:17px;height:17px}
.rp-btn:focus-visible,.rp-dot:focus-visible{outline:2px solid var(--purple,#6FA89A);outline-offset:3px;border-radius:999px}

.rp-sr{position:absolute;width:1px;height:1px;margin:-1px;padding:0;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0}

/* ---------- full-size viewer ---------- */
.rp-lb{
  position:fixed;inset:0;z-index:1000;display:grid;place-items:center;
  padding:clamp(16px,4vw,48px);
  background:rgba(6,30,29,.84);-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);
  animation:rp-lb-fade .35s ease both;
}
.rp-lb-card{
  display:flex;flex-direction:column;width:min(100%,780px);max-height:100%;
  border-radius:16px;overflow:hidden;background:var(--card,#FBFAF4);
  box-shadow:0 40px 90px -30px rgba(0,0,0,.7);
  animation:rp-lb-pop .5s var(--rp-ease,ease) both;
}
.rp-lb-scroll{flex:1 1 auto;min-height:0;overflow:auto;background:#fff;-webkit-overflow-scrolling:touch}
.rp-lb-scroll img{display:block;width:100%;height:auto}
.rp-lb-cap{padding:14px 20px 16px;border-top:1px solid var(--line)}
.rp-lb-cap strong{display:block;font-size:15px;line-height:1.35;color:var(--navy);font-weight:600}
.rp-lb-cap span{display:block;margin-top:3px;font-size:13px;color:var(--muted)}
.rp-lb-x,.rp-lb-nav{
  position:absolute;width:46px;height:46px;border-radius:50%;display:grid;place-items:center;
  border:0;padding:0;background:rgba(251,250,244,.95);color:var(--navy);
  box-shadow:0 12px 24px -10px rgba(0,0,0,.6);
  transition:transform .3s,background .3s,color .3s;
}
.rp-lb-x:hover,.rp-lb-nav:hover{background:var(--navy);color:#fff}
.rp-lb-x{top:clamp(12px,2.5vw,24px);right:clamp(12px,2.5vw,24px)}
.rp-lb-nav{top:50%;margin-top:-23px}
.rp-lb-prev{left:clamp(8px,2vw,24px)}
.rp-lb-next{right:clamp(8px,2vw,24px)}
.rp-lb-x svg,.rp-lb-nav svg{width:18px;height:18px}
.rp-lb-x:focus-visible,.rp-lb-nav:focus-visible{outline:2px solid #fff;outline-offset:3px}
@keyframes rp-lb-fade{from{opacity:0}}
@keyframes rp-lb-pop{from{opacity:0;transform:translateY(24px) scale(.96)}}

/* ---------- responsive ---------- */
/* laptops + tablets: sizes follow your fit-to-screen unit (--u / --g) */
@media(min-width:641px) and (min-height:520px){
  .rp-stage{height:calc(460*var(--u))}
  .rp-pw{width:min(calc(320*var(--u)),64%)}
  .rp-pill{bottom:calc(24*var(--g))}
  .rp-av{width:calc(64*var(--u));height:calc(64*var(--u))}
  .rp-who strong{font-size:max(16px,calc(19*var(--u)))}
  .rp-who span{font-size:max(12.5px,calc(13.5*var(--u)))}
  .rp-tag strong{font-size:max(13.5px,calc(15*var(--u)))}
  .rp-tag small{font-size:max(9.5px,calc(10*var(--u)))}
  .rp-controls{margin-top:calc(20*var(--g))}
  .rp-btn{width:max(40px,calc(44*var(--u)));height:max(40px,calc(44*var(--u)))}
}
/* tablet: stacked + centered, same flow as .hero-copy */
@media(max-width:1020px){
  .rp{max-width:560px;margin-inline:auto}
}
/* phones */
@media(max-width:640px){
  .rp-stage{height:min(calc(86vw + 40px),430px)}
  .rp-pw{width:min(270px,66%);right:7%}
  .rp-tag{left:-8%;bottom:16%;padding:9px 12px 10px;max-width:68%}
  .rp-tag strong{font-size:13px}
  .rp-tag small{font-size:9px}
  .rp-pill{bottom:14px;gap:11px;padding:6px 18px 6px 6px}
  .rp-av{width:54px;height:54px}
  .rp-who strong{font-size:16px}
  .rp-who span{font-size:12.5px}
  .rp-dots{gap:6px}
  .rp-dot.is-on{width:30px}
  .rp-btn{width:40px;height:40px}
  .rp-count{display:none}
  .rp-sp{transform-origin:center}
  .rp-lb-nav{top:auto;bottom:clamp(12px,3vw,24px);margin-top:0}
}
@media(max-width:380px){
  .rp-dot.is-on{width:24px}
  .rp-btn{width:36px;height:36px}
}
/* reduced motion (your global rule already stops animations) */
@media(prefers-reduced-motion:reduce){
  .rp-slide.is-leaving{display:none}
  .rp-dot.is-on .rp-fill{transform:none}
  .rp-orbit-dot{display:none}
}